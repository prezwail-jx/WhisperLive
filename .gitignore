# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyc
*.pyo
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
venv-*/
whisper_env/
env/
ENV/
.env

# Packaging and build output
*.egg-info/
build/
dist/
*.egg
.eggs/
*.so
*.o


# Meeting hotword files contain deployment-specific terms
config/hotwords.d/*
!config/hotwords.d/.gitkeep
config/summary_templates/*
