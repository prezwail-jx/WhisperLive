mic_test.wav
mic_test_resampled.wav
*.mp4
*.wav

# Local model, cache, and vendored source directories
models/
/model/
.cache/
third_party/

# Docker/image archives and generated docs
*.tar
*.tar.gz
docs/site/

# Logs and temporary files
/logs/
*.log
*.tmp
*.temp
.DS_Store
*.docx
*.json

# IDE/editor files
.idea/
.vscode/
*.swp
*.swo
/deploy/
